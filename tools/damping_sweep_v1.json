          ]
        }
      ]
    },
    {
      "name": "low-ratio",
      "hypothesis": "lowRatio below 1.0 is the small-room effect: an undamped low end turns long tails to mud (stage 05-damping.md, 'What it does musically' and 'Worth sweeping early').",
      "values": [
        {
          "label": "moderate",
          "overrides": [
            {"op": "replace", "path": "/composition/stages/1/damping/lowRatio", "value": 0.5}
          ]
        },
        {
          "label": "strong",
          "overrides": [
