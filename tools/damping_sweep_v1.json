  "axes": [
    {
      "name": "high-ratio",
      "hypothesis": "highRatio 1.0 -> 0.2 at fixed RT60 is the decay-curve surface, and the clearest demonstration of why per-band measurement was necessary (stage 05-damping.md, 'Worth sweeping early').",
      "values": [
        {
          "label": "none",
          "overrides": [
            {"op": "replace", "path": "/composition/stages/1/damping/highRatio", "value": 1.0}
